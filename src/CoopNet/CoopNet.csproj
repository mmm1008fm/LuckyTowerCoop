<Project Sdk="Microsoft.NET.Sdk">

  <!-- Steam-транспорт коопа: Spacewar (AppID 480) в отдельном процессе.
       Публикация: dotnet publish -c Release (самодостаточный exe, у друга не нужен .NET). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <GameDir Condition="'$(GameDir)' == ''">D:\game\Lucky.Tower.Ultimate.v1.1.4</GameDir>
    <SidecarDeployDir>$(GameDir)\BepInEx\plugins\LuckyTowerCoop\CoopNet</SidecarDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="20.1.0" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <!-- После публикации: exe + Valve steam_api64.dll (из папки игры, SDK 1.53a = Steamworks.NET 20.1.0) + steam_appid.txt -->
  <Target Name="DeploySidecar" AfterTargets="Publish">
    <MakeDir Directories="$(SidecarDeployDir)" />
    <Copy SourceFiles="$(PublishDir)CoopNet.exe" DestinationFolder="$(SidecarDeployDir)" />
    <Copy SourceFiles="$(GameDir)\Lucky Tower Ultimate_Data\Plugins\x86_64\steam_api64.dll.valve" DestinationFiles="$(SidecarDeployDir)\steam_api64.dll" Condition="Exists('$(GameDir)\Lucky Tower Ultimate_Data\Plugins\x86_64\steam_api64.dll.valve')" />
    <Copy SourceFiles="$(GameDir)\Lucky Tower Ultimate_Data\Plugins\x86_64\steam_api64.dll" DestinationFiles="$(SidecarDeployDir)\steam_api64.dll" Condition="!Exists('$(GameDir)\Lucky Tower Ultimate_Data\Plugins\x86_64\steam_api64.dll.valve')" />
    <WriteLinesToFile File="$(SidecarDeployDir)\steam_appid.txt" Lines="480" Overwrite="true" />
    <Message Importance="high" Text="Deployed CoopNet -> $(SidecarDeployDir)" />
  </Target>

</Project>
